{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "angular",
      "installCommand": "npm install",
      "buildCommand": "npx ng build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}